# e-RESERVE — production template. Copy to .env on the VPS and fill in the blanks.
#   cp deploy/.env.production.example .env && php artisan key:generate

APP_NAME=e-RESERVE
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN

LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Database (create the DB and a dedicated user; never use root) -----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_reserve
DB_USERNAME=ereserve
DB_PASSWORD=

# --- Sessions / cache / queue -------------------------------------------------
# Redis is optional at this scale. Start with the database drivers; switch to
# redis later by installing redis-server + `composer require predis/predis`.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Outgoing email -----------------------------------------------------------
# Option A (no domain of your own): the SSC Google Workspace mailbox over Gmail SMTP.
#   Needs 2-Step Verification + an App Password on that mailbox (see deploy/SMTP.md).
#   Workspace allows roughly 2,000 recipients/day per mailbox.
# Option B (own domain): Amazon SES / Brevo / Mailgun / Resend: use their SMTP host.
#   Port 587 -> MAIL_SCHEME=smtp (STARTTLS is automatic).  Port 465 -> MAIL_SCHEME=smtps.
#   NOTE: "tls"/"ssl" are NOT valid values; only smtp or smtps.
# Then check it with:  php artisan ereserve:mail-test you@example.com
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sscarasofnasugbu.ereserve@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="sscarasofnasugbu.ereserve@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Exact non-university addresses allowed to hold a STAFF login (comma-separated).
STAFF_EXTRA_EMAILS=

# --- Google sign-in (Socialite) ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/google/callback"
